concrete WordNetPol of WordNet = CatPol ** open Prelude, MorphoPol, GrammarPol, (E = ExtendPol), (S=StructuralPol), (ResPol=ResPol), (P=ParadigmsPol) in {

oper
  mkVS : Verb -> VS = \v -> lin VS v ;
  mkVA : Verb -> VA = \v -> lin VA (v ** {c={s=""; adv=False; c=ResPol.Nom}}) ;
  mkVV : Verb -> VV = \v -> lin VV v ;
  mkVQ : Verb -> VQ = \v -> lin VQ v ;
  mkV2V : Verb -> Complement -> V2V = \v,p -> lin V2V (v ** {c=p}) ;
  mkV2S : Verb -> Complement -> V2S = \v,p -> lin V2S (v ** {c=p}) ;
  mkV2A : Verb -> Complement -> V2A = \v,p -> lin V2A (v ** {c={s=""; adv=False; c=ResPol.Nom}; c2=mkCompl "" Nom}) ;
  mkA2 : Adj -> Complement -> A2 = \a,p -> lin A2 (a ** {c=p}) ;
  mkAdA : Str -> AdA = \s -> lin AdA {s=s} ;
  mkAdN : Str -> AdN = \s -> lin AdN {s=s} ;
