lin some_Quant = {
    s = \\_ => table {
      Sg => \\g,c => M.prepCase c ++ "quelque" ;
      Pl => \\_,c => M.prepCase c ++ "quelques"
      } ;
    sp = table {
      Sg => \\g,c => M.prepCase c ++ "quelqu'un" ;
      Pl => \\g,c => M.prepCase c ++ "quelques"
      } ;
    spn= \\c => M.prepCase c ++ "quelque chose" ;
    s2 = [] ; ---- "-là" ;
    isNeg = False
    } ;
