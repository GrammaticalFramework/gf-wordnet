lin come_to_adj_VP a v = {
  s = \\_,_,pol,agr =>
    case pol of {Pos => "kuwa" ; Neg => "kutokuwa"} ++
    a.s ! AAdj agr.g agr.n ;
  passive = \\_,_,pol,agr =>
    case pol of {Pos => "kuwa" ; Neg => "kutokuwa"} ++
    a.s ! AAdj agr.g agr.n ;
  obj = \\_ => [] ;
  inf = \\pol,agr => case pol of {Pos => "kuwa" ; Neg => "kutokuwa"} ++ a.s ! AAdj agr.g agr.n ;
  passiveInf = \\pol,agr => case pol of {Pos => "kuwa" ; Neg => "kutokuwa"} ++ a.s ! AAdj agr.g agr.n ;
  imp = \\pol,_ => case pol of {Pos => "kuwa" ; Neg => "usiwe"} ;
  passiveImp = \\pol,_ => case pol of {Pos => "kuwa" ; Neg => "usiwe"}
  } ; --guessed
