concrete WordNetGla of WordNet = CatGla ** open Prelude, ParadigmsGla, (R=ResGla), (S=StructuralGla) in {

oper
  compoundN = overload {
    compoundN : {s : R.Case => R.Species => R.Number => Str ;
                 voc : R.Number => Str ; g : R.Gender} -> Str -> N = \noun, complement ->
      noun ** {
        s = \\cas, species, number => noun.s ! cas ! species ! number ++ complement ;
        voc = \\number => noun.voc ! number ++ complement ;
        lock_N = <>
      } ;
    compoundN : {s : R.Case => R.Species => R.Number => Str ;
                 voc : R.Number => Str ; g : R.Gender} ->
                {s : R.AForm => Str ; voc : R.Gender => Str ; compar : Str} -> N =
      \noun, adjective ->
      noun ** {
        s = \\cas, species, number =>
          noun.s ! cas ! species ! number ++
          adjective.s ! R.aform cas number noun.g ;
        voc = \\number => noun.voc ! number ++ adjective.voc ! noun.g ;
        lock_N = <>
      }
    } ;

  compoundV : V -> Str -> V = \verb, complement ->
    verb ** {
      s = verb.s ++ complement ;
      conditional = \\number => verb.conditional ! number ++ complement ;
      imperative = \\person, number => verb.imperative ! person ! number ++ complement ;
      future = \\form => verb.future ! form ++ complement ;
      past = \\form => verb.past ! form ++ complement ;
      noun = verb.noun ++ complement ;
      participle = verb.participle ++ complement
    } ;

  simplePrep : Str -> Prep = \preposition ->
    noPrep ** {s = \\_ => preposition} ;

  -- Fallback paradigms for dictionary phrases which have no inflectional
  -- entry yet.  They keep genuine Gaelic translations in the output rather
  -- than leaking GF's [identifier] placeholder into generated text.
  wnA : Str -> A = \x -> lin A {
    s = \\_ => x ; voc = \\_ => x ; compar = x
    } ;

  wnA2 : Str -> A2 = \x -> lin A2 (wnA x ** {c2 = R.emptyPrep}) ;

  wnV : Str -> V = \x -> lin V {
    s = x ; conditional = \\_ => x ; imperative = \\_,_ => x ;
    future = \\_ => x ; past = \\_ => x ; noun = x ; participle = x ;
    copular = False ; complement = []
    } ;

  wnV2 : Str -> V2 = \x -> lin V2 (wnV x ** {c2 = R.emptyPrep}) ;

  -- Dictionary entries expressed as _a bhith_ plus a complement are
  -- copular predicates, not lexical verbal nouns.  Marking them as such
  -- prevents SentenceGla from adding a second progressive particle.
  wnCopV : Str -> V = \x -> lin V {
    s = "bi" ;
    conditional = \\_ => "bhiodh" ;
    imperative = \\_,_ => "bi" ;
    future = \\form => case form of {R.Indep => "bidh" ; R.Dep => "bi"} ;
    past = \\form => case form of {R.Indep => "bha" ; R.Dep => "robh"} ;
    noun = "bhith" ; participle = "air a bhith" ;
    copular = True ; complement = x
    } ;

  -- Modal _can_ is most naturally expressed as a copular ability phrase.
  -- Keeping it copular also lets SentenceGla place the subject correctly.
  wnCopVV : Str -> VV = \x -> lin VV (wnV "bi" ** {
    copular = True ; complement = x
    }) ;

