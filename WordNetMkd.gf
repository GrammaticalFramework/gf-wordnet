concrete WordNetMkd of WordNet = CatMkd ** open ParadigmsMkd, (S=StructuralMkd), (E=ExtendMkd), (G=GrammarMkd), (R=ResMkd), Prelude in {

oper invA : Str -> A = \s -> lin A {s = \\_,_ => s; adverb = s} ;
oper mkAFull : Str -> Str -> Str -> Str -> A = \m,f,n,p ->
  lin A (R.mkAdj m f n p (p + "от") (f + "та") (n + "то") (p + "те") (p + "ов") (f + "ва") (n + "во") (p + "ве") (p + "он") (f + "на") (n + "но") (p + "не") n) ;
oper invN : Str -> N = \s -> lin N (R.mkNoun s s (s + "то") (s + "та") (s + "во") (s + "ва") (s + "но") (s + "на") s s s R.Neuter) ;

