lin tend_VP vp =
  let inf : Str = vp.s ! VInf ++ vp.obj ++ vp.adv ;
      pred : Number => Str = table {
        Sg => "hajlamos" ;
        Pl => "hajlamosak"
        } ;
   in useV ResHun.copula ** {
        s = \\vf => case vf of {
          VPres P3 n => pred ! n ++ inf ;
          VPres _  n => pred ! n ++ ResHun.copula.s ! vf ++ inf ;
          VPast _  n => pred ! n ++ ResHun.copula.s ! vf ++ inf ;
          _          => pred ! Sg ++ ResHun.copula.s ! vf ++ inf
          } ;
        obj = [] ;
        adv = [] ;
        c2 = Acc ;
        } ;
